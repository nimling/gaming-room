# Managed by the Arcade launcher (games/openra-ra.yaml). Written at every start.
# OpenRA reads MiniYAML: indent with tabs.
Player:
	Name: {{ nickname }}
Game:
	IntroductionPromptVersion: 1
Graphics:
	Mode: PseudoFullscreen
	CapFramerate: True
	MaxFramerate: {{ fps_cap }}
Debug:
	SendSystemInformation: False
	SystemInformationVersionPrompt: 6
