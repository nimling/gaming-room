{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade",
  "version": "0.1.0",
  "identifier": "no.nimtech.arcade",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arcade",
        "width": 1600,
        "height": 900,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
