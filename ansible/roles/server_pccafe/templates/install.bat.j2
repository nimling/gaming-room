@echo off
rem Managed by gaming-room Ansible (roles/server_pccafe).
rem Runs once, at the end of the Windows install (dockur copies it to C:\OEM).

rem Seats find the cafe server by UDP broadcast on 27036 and connect on TCP 27037.
netsh advfirewall firewall add rule name="Steam PC Cafe discovery" dir=in action=allow protocol=UDP localport=27036
netsh advfirewall firewall add rule name="Steam PC Cafe clients" dir=in action=allow protocol=TCP localport=27037
