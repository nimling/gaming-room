# Managed by gaming-room Ansible (roles/server_pccafe).
# Windows VM for the Steam PC Café Server. Web viewer: http://<server>:8006
services:
  windows:
    image: {{ pccafe_image }}
    container_name: pccafe
    # Host network: the VM's NIC is the tap on {{ pccafe_bridge }}, not a
    # container network. Windows gets its address from the router.
    network_mode: host
    environment:
      VERSION: "{{ pccafe_windows_version }}"
      RAM_SIZE: "{{ pccafe_ram }}"
      CPU_CORES: "{{ pccafe_cpus }}"
      DISK_SIZE: "{{ pccafe_disk }}"
      USERNAME: "{{ pccafe_windows_user }}"
      PASSWORD: "{{ pccafe_password.content | default('') | b64decode | trim }}"
      # dockur sets up no network; the NIC comes from ARGUMENTS.
      NETWORK: "N"
      ARGUMENTS: "-netdev tap,id=hostnet0,ifname={{ pccafe_tap }},script=no,downscript=no -device {{ pccafe_adapter }},id=net0,netdev=hostnet0,mac={{ pccafe_mac }}"
    devices:
      - /dev/kvm
      - /dev/net/tun
    volumes:
      - ./storage:/storage
      - ./shared:/shared
      - ./oem:/oem
    stop_grace_period: 2m
    restart: unless-stopped
