# Managed by gaming-room Ansible.
[Unit]
Description=End the player session after inactivity
ConditionUser={{ seat_player_user }}
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/seat-idle
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
