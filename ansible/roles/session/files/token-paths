# Managed by gaming-room Ansible.
# Where launchers and browsers keep logins, relative to the player's home.
# Format: <glob>|<optional extended regex the file must match>
# Add a line whenever a new launcher goes on the seats.
# The gaming server uses this list too, before it publishes a Battle.net
# prefix to the seats (battlenet-prefix-publish, roles/server_gameshare).

# Steam
.local/share/Steam/config/loginusers.vdf|"AccountName"
.local/share/Steam/config/config.vdf|ConnectCache
.local/share/Steam/local.vdf|ConnectCache
.steam/registry.vdf|"AutoLoginUser"[[:space:]]+"[^"]+"

# Epic and GOG (Heroic / Legendary)
.config/legendary/user.json|
.config/heroic/gog_store/auth.json|

# Battle.net, in its Wine prefix (games/battlenet-seat): saved account
# names, the web login cookie, and Windows credentials, where "Keep me
# logged in" goes.
.local/share/arcade/prefixes/battlenet/drive_c/users/*/AppData/Roaming/Battle.net/Battle.net.config|"SavedAccountNames"[[:space:]]*:[[:space:]]*"[^"]
.local/share/arcade/prefixes/battlenet/drive_c/users/*/AppData/Local/Battle.net/BrowserCaches/*/Cookies|BA-tassadar
.local/share/arcade/prefixes/battlenet/drive_c/users/*/AppData/Local/Battle.net/BrowserCaches/*/Network/Cookies|BA-tassadar
.local/share/arcade/prefixes/*/user.reg|Credential Manager

# World of Warcraft: account name and per-account data (WTF), linked into the
# home from /games (wow-links)
.local/share/arcade/wow/*/WTF/Config.wtf|accountName
.local/share/arcade/wow/*/WTF/Account|

# Discord
.config/discord/Local Storage|

# Spotify (Flatpak, and the native client if it ever comes back)
.var/app/com.spotify.Client/config/spotify/prefs|autologin\.
.config/spotify/prefs|autologin\.

# Browsers
.mozilla/firefox/*/cookies.sqlite|
.mozilla/firefox/*/logins.json|
.config/chromium/*/Cookies|
.config/google-chrome/*/Cookies|

# Desktop keyrings
.local/share/keyrings/*.keyring|
.local/share/kwalletd/*.kwl|
