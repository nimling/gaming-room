# Managed by gaming-room Ansible. Private values for ansible-pull runs.
# Written by a push run from the gaming server; not in the public repo.
seat_admin_ssh_keys: {{ seat_admin_ssh_keys | to_json }}
seat_orchestrator_ssh_keys: {{ seat_orchestrator_ssh_keys | to_json }}
seat_orchestrator_source: {{ seat_orchestrator_source | to_json }}
# The account a first run logs in with is only allowed for that run; pull
# runs must not bring it back.
seat_extra_ssh_users: {{ seat_extra_ssh_users | difference([ansible_user | default('')]) | to_json }}
seat_admin_password_hash: {{ seat_admin_password_hash | default('') | to_json }}
seat_tier_override: {{ seat_tier_override | to_json }}
seat_update_freeze_until: {{ seat_update_freeze_until | to_json }}
seat_config_branch: {{ seat_config_branch | to_json }}
arcade_voice_server: {{ arcade_voice_server | to_json }}
seat_display: {{ seat_display | to_json }}
# Game share: without these, nightly pulls would skip it and games would
# only update on push runs.
seat_gameshare: {{ seat_gameshare | to_json }}
seat_shared_games: {{ seat_shared_games | to_json }}
