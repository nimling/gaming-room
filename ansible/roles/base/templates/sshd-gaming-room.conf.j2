# Managed by gaming-room Ansible
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
{% set sources = ([seat_orchestrator_source] if seat_orchestrator_source is string else seat_orchestrator_source) | select | list %}
{# cafe-sync: the gaming server's read-only Steam café copy (roles/games). #}
{% set cafe = (' ' ~ steam_cafe_user ~ '@' ~ seat_steam_cafe_server) if seat_steam_cafe_server | length > 0 else '' %}
AllowUsers {{ seat_admin_user }}{% if sources %}{% for source in sources %} {{ seat_orchestrator_user }}@{{ source }}{% endfor %}{% else %} {{ seat_orchestrator_user }}{% endif %}{{ cafe }}{% for user in seat_extra_ssh_users %} {{ user }}{% endfor %}

