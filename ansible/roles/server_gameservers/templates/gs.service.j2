# Managed by gaming-room Ansible (roles/server_gameservers).
# Preset: server/presets/{{ p.id }}.yaml
{% set home = gameservers_state_root ~ '/' ~ p.id %}
{% set workdir = gameshare_root ~ '/' ~ p.workdir %}
{# systemd needs an absolute program path: ./prog is taken from the workdir. #}
{% set args = [workdir ~ p.command[0][1:] if p.command[0].startswith('./') else p.command[0]] + p.command[1:] %}
[Unit]
Description=Game server: {{ p.name }}
After=network-online.target
Wants=network-online.target

[Service]
User={{ gameservers_user }}
Group={{ gameservers_user }}
Environment=HOME={{ home }}
WorkingDirectory={{ workdir }}
ExecStart={% for a in args %}"{{ a | replace('{home}', home) | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') }}"{{ ' ' if not loop.last }}{% endfor %}

Restart=on-failure
RestartSec=10
# A clean stop: UT2004 exits with 42 after SIGTERM ("appRequestExit(0)"),
# which systemd would otherwise mark as failed, and then restart.
SuccessExitStatus=42 SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ home }}
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
{% if p.always_on | default(false) %}

[Install]
WantedBy=multi-user.target
{% endif %}
